---
import Base from '../layouts/Base.astro';
---

<Base lang="es" title="Página no encontrada · Eduardo Coronell" noindex>
  <main class="grid min-h-dvh place-items-center px-6 py-20">
    <div class="max-w-md text-center">
      <p class="font-mono text-sm text-accent">&gt; 404</p>
      <h1 class="mt-4 font-serif text-6xl leading-none text-ink text-balance">Página no encontrada</h1>
      <p class="mt-5 text-muted">Esta ruta no existe. <span lang="en">This page doesn’t exist.</span></p>
      <div class="mt-8 flex justify-center gap-3 text-sm">
        <a href="/" class="rounded-lg bg-accent px-4 py-2.5 font-medium text-accent-ink press hover:opacity-90">Ir al inicio</a>
        <a href="/en/" lang="en" class="rounded-lg border border-line-strong px-4 py-2.5 font-medium text-ink press hover:bg-surface-2">Go Home</a>
      </div>
    </div>
  </main>
</Base>
