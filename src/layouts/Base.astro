---
import { Font, fontData } from 'astro:assets';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  noindex?: boolean;
}

const { lang, title, noindex = false } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(languages[lang].path, Astro.site);
const ogImage = new URL(`/og/${lang}.png`, Astro.site);
const locale = languages[lang].locale;

// Las tres familias aparecen en la primera pantalla. Se precarga solo la variante latin
// (la primera de cada familia en astro.config.mjs): todo el texto del sitio cabe en ella.
const fontFamilies = ['--font-dm-serif', '--font-inter', '--font-jetbrains'] as const;
const fontPreloads = fontFamilies.map((family) => fontData[family][0].src[0].url);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: t.hero.role,
  url: site.url,
  image: new URL('/apple-touch-icon.png', Astro.site).href,
  sameAs: [site.linkedin, site.github],
  address: { '@type': 'PostalAddress', addressLocality: 'Barranquilla', addressCountry: 'CO' },
  knowsAbout: ['PL/SQL', 'PostgreSQL', 'Oracle', 'Java', 'Kotlin', 'Docker'],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      Object.values(languages).map((l) => (
        <link rel="alternate" hreflang={l.locale} href={new URL(l.path, Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta name="theme-color" content="#0b1012" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f1f5f3" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {fontFamilies.map((family) => <Font cssVariable={family} />)}
    {fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <!-- Aplica el tema antes de pintar para evitar el parpadeo -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
          else if (window.matchMedia('(prefers-color-scheme: light)').matches) theme = 'light';
        } catch (e) {}
        root.dataset.theme = theme;
        root.classList.add('js');
        var bar = theme === 'dark' ? '#0b1012' : '#f1f5f3';
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
          meta.setAttribute('content', bar);
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <slot />
    <Analytics />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
