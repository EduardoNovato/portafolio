---
import HeroQuery from './HeroQuery.astro';
import UiIcon from './UiIcon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`;
---

<section id={t.sections.home.id} class="flex min-h-[calc(100svh-57px)] items-center py-16 lg:min-h-svh lg:py-20">
  <div class="grid w-full items-center gap-14 xl:grid-cols-[minmax(0,1fr)_minmax(0,430px)] xl:gap-10">
    <div class="@container min-w-0">
      <!-- El tamaño depende del ancho de esta columna (cqi), no de la pantalla, para que nunca choque con la ventana SQL -->
      <h1 translate="no" class="font-serif text-[clamp(3.5rem,21cqi,7.25rem)] leading-[0.9] tracking-[-0.015em] text-ink">
        {site.firstName}<br />{site.lastName}
      </h1>
      <p class="reveal mt-7 font-mono text-[15px] text-accent sm:text-base" style="--reveal-delay: 60ms">
        <span aria-hidden="true">&gt; </span>{t.hero.role}<span class="caret" aria-hidden="true"></span>
      </p>
      <p class="reveal mt-5 max-w-[32ch] text-lg leading-relaxed text-pretty text-muted sm:text-xl" style="--reveal-delay: 120ms">
        {t.hero.tagline}
      </p>
      <p class="reveal mt-8 flex items-start gap-3 text-sm leading-relaxed text-muted" style="--reveal-delay: 180ms">
        <span class="pulse-dot mt-[0.55em] shrink-0" aria-hidden="true"></span>
        {t.hero.availability}
      </p>
      <div class="reveal mt-9 flex flex-wrap gap-2.5 lg:hidden" style="--reveal-delay: 220ms">
        <a href={site.cv} download class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-accent-ink transition-opacity hover:opacity-90">
          <UiIcon name="download" />
          {t.sidebar.cv}
          {t.sidebar.cvLang && <span class="font-mono text-[10px] opacity-80" aria-hidden="true">{t.sidebar.cvLang}</span>}
          {t.sidebar.cvLangLong && <span class="sr-only">{t.sidebar.cvLangLong}</span>}
        </a>
        <a href={mailto} class="inline-flex items-center gap-2 rounded-lg border border-line-strong px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-surface-2">
          <UiIcon name="mail" />
          {t.sidebar.write}
        </a>
      </div>
    </div>
    <HeroQuery lang={lang} class="w-full max-w-[460px] xl:max-w-none" />
  </div>
</section>
