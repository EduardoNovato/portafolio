---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import { formatMonth, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  index: string;
}

const { lang, index } = Astro.props;
const t = useTranslations(lang);
const jobs = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start));

// "texto **15 %** texto" -> partes alternas normal / resaltado
const split = (text: string) => text.split(/\*\*(.+?)\*\*/g);
---

<section id={t.sections.experience.id} class="border-t border-line py-24 sm:py-28">
  <SectionHeading index={index} title={t.sections.experience.label} intro={t.experience.intro} />

  <ol>
    {
      jobs.map(({ data }) => (
        <li class="reveal grid gap-5 border-t border-line py-10 first:border-t-0 first:pt-0 md:grid-cols-[170px_minmax(0,1fr)] md:gap-10">
          <div class="flex flex-row items-center gap-3 md:flex-col md:items-start">
            <p class="font-mono text-xs text-faint">
              {formatMonth(data.start, lang)} — {data.end ? formatMonth(data.end, lang) : t.experience.present}
            </p>
            {!data.end && (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/30 bg-accent-soft px-2.5 py-0.5 font-mono text-[10.5px] text-accent">
                <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
                {t.experience.current}
              </span>
            )}
          </div>
          <div>
            <h3 class="font-serif text-[1.75rem] leading-tight text-ink">{data.role[lang]}</h3>
            <p class="mt-1 text-[15px] text-muted" translate="no">{data.company}</p>
            <ul class="mt-5 space-y-3">
              {data.highlights[lang].map((item) => (
                <li class="flex gap-3 text-[15px] leading-relaxed text-muted">
                  <span class="mt-[0.8em] h-px w-3 shrink-0 bg-line-strong" aria-hidden="true" />
                  <span>
                    {split(item).map((part, i) => (i % 2 === 1 ? <strong class="font-medium text-accent">{part}</strong> : part))}
                  </span>
                </li>
              ))}
            </ul>
            <ul class="mt-6 flex flex-wrap gap-1.5" translate="no">
              {data.stack.map((tech) => (
                <li class="whitespace-nowrap rounded-md border border-line px-2 py-0.5 font-mono text-[11.5px] text-muted">{tech}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
