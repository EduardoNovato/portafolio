---
interface Props {
  index: string;
  title: string;
  intro?: string;
}

const { index, title, intro } = Astro.props;
---

<header class="reveal mb-12 max-w-2xl">
  <p class="flex items-center gap-3 font-mono text-xs text-accent" aria-hidden="true">
    <span>{index}</span>
    <span class="h-px w-10 bg-accent/50"></span>
  </p>
  <h2 class="mt-4 font-serif text-[2.6rem] leading-[1.05] text-balance text-ink sm:text-5xl">{title}</h2>
  {intro && <p class="mt-4 text-base leading-relaxed text-pretty text-muted sm:text-lg">{intro}</p>}
</header>
