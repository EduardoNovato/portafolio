---
import { Image } from 'astro:assets';
import avatar from '../assets/eduardo-avatar.jpg';
import ThemeSwitch from './ThemeSwitch.astro';
import UiIcon from './UiIcon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="sticky top-0 z-30 flex items-center justify-between border-b border-line bg-bg/75 px-4 py-2.5 backdrop-blur-xl backdrop-saturate-150 sm:px-6 lg:hidden">
  <a href={`#${t.sections.home.id}`} class="flex items-center gap-2.5 rounded-lg">
    <Image src={avatar} alt="" width={30} height={30} densities={[1, 2]} class="size-[30px] rounded-full border border-line-strong object-cover" loading="eager" />
    <span class="font-serif text-lg text-ink">{site.name}</span>
  </a>
  <div class="flex items-center gap-0.5">
    <ThemeSwitch lang={lang} compact />
    <button
      type="button"
      data-menu-open
      aria-controls="sidebar"
      aria-expanded="false"
      aria-label={t.sidebar.menuOpen}
      class="grid size-10 place-items-center rounded-lg text-ink press hover:bg-surface-2"
    >
      <UiIcon name="menu" class="size-5" />
    </button>
  </div>
</header>
