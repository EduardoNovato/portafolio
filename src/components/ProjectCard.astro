---
import type { CollectionEntry } from 'astro:content';
import ProjectArt from './ProjectArt.astro';
import UiIcon from './UiIcon.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>['data'];
  lang: Lang;
  delay?: number;
}

const { project, lang, delay = 0 } = Astro.props;
const t = useTranslations(lang);
---

<article
  class="reveal theme-fade group flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-colors duration-300 hover:border-line-strong"
  style={`--reveal-delay: ${delay}ms`}
>
  <div class="dot-grid relative aspect-[16/9] overflow-hidden border-b border-line bg-surface-2">
    <div class="absolute inset-0 transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100">
      <ProjectArt kind={project.art} />
    </div>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="min-w-0 font-serif text-[1.65rem] leading-tight text-ink" translate="no">{project.title}</h3>
      <span class="font-mono text-xs text-faint">{project.year}</span>
    </div>
    <p class="mt-1 font-mono text-[11.5px] text-accent">{project.kind[lang]}</p>
    <p class="mt-3 text-[15px] leading-relaxed text-pretty text-muted">{project.description[lang]}</p>

    <ul class="mt-5 flex flex-wrap gap-1.5" translate="no">
      {project.stack.map((tech) => <li class="whitespace-nowrap rounded-md border border-line px-2 py-0.5 font-mono text-[11.5px] text-muted">{tech}</li>)}
    </ul>

    <div class="mt-auto flex items-center gap-5 pt-6 text-sm">
      <a
        href={project.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-medium text-ink transition-colors hover:text-accent"
      >
        <UiIcon name="github" />
        {t.projects.code}<span class="sr-only"> · {project.title}</span>
        <UiIcon name="arrow" class="size-3.5 text-faint" />
      </a>
      {
        project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-medium text-ink transition-colors hover:text-accent"
          >
            {t.projects.demo}
            <span class="sr-only"> · {project.title}</span>
            <UiIcon name="arrow" class="size-3.5 text-faint" />
          </a>
        )
      }
    </div>
  </div>
</article>
